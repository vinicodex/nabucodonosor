# ── LLM ──────────────────────────────────────────────────────────────────────
# "ollama" for local dev, "groq" for production (HuggingFace Spaces)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b

# Required only when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.2-3b-preview

# ── Embeddings ────────────────────────────────────────────────────────────────
# "ollama" for local dev, "sentence-transformers" for production
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=768

# ── Vector Store ──────────────────────────────────────────────────────────────
CHROMA_PATH=./data/chroma_db
COLLECTION_NAME=cv_knowledge

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_DB_PATH=./data/cache.db
EXACT_CACHE_TTL_HOURS=24
SEMANTIC_CACHE_THRESHOLD=0.95

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_K=5
RETRIEVAL_INITIAL_K=20
RERANKER_THRESHOLD=0.10
ENABLE_QUERY_REWRITING=true

# ── Guardrails ────────────────────────────────────────────────────────────────
MAX_QUESTION_LENGTH=500
TOPIC_GUARD_THRESHOLD=0.5
